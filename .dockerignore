# --- Build Context Optimization ---
# This file ensures only the necessary FastAPI code is sent to Docker/GCP

# Version Control & Metadata
.git/
.gitignore
.github/
.agentignore
.python-version
.claude/
.gemini/
*.json
!pyproject.toml
!package.json
!package-lock.json
!web/package.json
!web/package-lock.json
!web/tsconfig*.json
!contracts/i18n/*.json
!contracts/*.json
*.log
*.pdf

# Docker Tooling
Dockerfile
.dockerignore

# Virtual Environments & dependencies
.env
.envrc
.direnv/
.venv/
venv/
env/
node_modules/

# Python Cache & Build Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
.states/
.web/
.venv_test/
scratch/
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/


# Miscellaneous & Temporary
.gradio/
reports/
generated_reports/
knowledge_base/
vector_store/
scripts/
old_versions/
gradio/
*.ipynb
.DS_Store
Thumbs.db

# The SPA's own build helper must reach the image build (root scripts/ stays
# ignored above).
!web/scripts/

# Documentation
docs/
# README.md is NOT ignored because pyproject.toml requires it for metadata
