# This direnv command activates your Python virtual environment (if using direnv)
layout pyenv smc-env

# Frontend API connectivity
export API_BASE_URL="http://localhost:8080"

# Shared local API key (Used by frontend to auth against backend)
export PRECONSULT_API_KEY="development_key_123"

# Per-session cookie signing key (required; generate with `openssl rand -hex 32`)
export SESSION_SECRET="development_session_secret_change_me"
# Set false only for local plain-HTTP development; must be true in production.
# export SESSION_COOKIE_SECURE="false"

# Session bootstrap. When true, POST /api/session/init is callable without a
# credential and issues the session cookie used by every other route. Keep it
# false until per-IP bucketing is verified in the deployed environment: if all
# requests resolved to one IP, the 20/day quota would be a single global cap.
# export ALLOW_PUBLIC_INIT="true"

# Google Analytics / Google Tag Manager (optional)
# Set GTM_ID to use Google Tag Manager (recommended for Google Ads + GA4).
# Falls back to GTAG_ID if GTM is not set.
# export GTM_ID="GTM-XXXXXXX"
# export GTAG_ID="G-XXXXXXXXXX"

# LLM provider. "vertex" (default) is what the deployed service is configured
# for; "bedrock" is the opt-in AWS path and additionally needs the AWS_* vars.
# Switching changes which third party receives clinical text: update the privacy
# copy and the deploy's secrets block in the same change.
# export LLM_PROVIDER="vertex"
# export VERTEX_AI_REGION="us-central1"
# export LLM_MODEL="gemini-2.5-flash"   # defaults per provider when unset

# AWS Bedrock (only when LLM_PROVIDER=bedrock). boto3 resolves credentials from
# its default chain; set an explicit pair only for local work.
# export AWS_ACCESS_KEY_ID="your_access_key_id"
# export AWS_SECRET_ACCESS_KEY="your_secret_access_key"
# export BEDROCK_REGION="us-east-1"

# Cloudflare DNS Management (used for domain configuration scripts)
# export CLOUDFLARE_ZONE_ID="your_zone_id_here"
# export CLOUDFLARE_API_TOKEN="your_api_token_here"

# Cloud Run Target URL (the direct Cloud Run service URL)
# export CLOUD_RUN_TARGET_URL="your-service-hash.us-central1.run.app"
