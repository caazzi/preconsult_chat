    {
      "expected": [
        "One?",
        "Two?"
      ],
      "input": "\n1.   One?\n2.    Two?",
      "name": "leading_spaces_after_marker"
    },
    {
      "expected": [
        "Is this one long\nquestion spanning two lines?",
        "Second?"
      ],
      "input": "\n1. Is this one long\nquestion spanning two lines?\n2. Second?",
