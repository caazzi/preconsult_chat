      "name": "numbered_dot"
    },
    {
      "expected": [
        "One?",
        "Two?"
      ],
      "input": "1) One?\n2) Two?",
      "name": "numbered_paren"
    },
    {
      "expected": [
        "One?",
        "Two?"
      ],
      "input": "- One?\n- Two?",
      "name": "dash"
    },
    {
      "expected": [
        "One?",
        "Two?",
        "Three?"
      ],
      "input": "One?\nTwo?\nThree?",
      "name": "plain_newline_fallback"
    },
    {
      "expected": [
        "Just one?"
      ],
      "input": "Just one?",
      "name": "single_line"
    },
    {
      "expected": [],
      "input": "",
      "name": "empty"
    },
    {
      "expected": [],
      "input": "   ",
      "name": "whitespace_only"
